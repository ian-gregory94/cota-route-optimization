  "config_snapshot": {
    "assumptions.yaml": "# Model assumptions. Everything here is an explicit research assumption,\n# not a verified COTA operating parameter.\ncrs:\n  geographic: \"EPSG:4326\"\n  projected: \"EPSG:32617\"   # UTM 17N, meters \u2014 used for all planar distance math\n\nservice_periods:\n  # Weekday periods, local time, [start_hour, end_hour). Trips assigned by first\n  # departure time. GTFS times >24:00 fold into 'owl'.\n  early:   [4, 6]\n  am_peak: [6, 9]\n  midday:  [9, 15]\n  pm_peak: [15, 18]\n  evening: [18, 22]\n  owl:     [22, 28]\n\noperations:\n  # Layover/recovery as fraction of round-trip running time (industry-typical\n  # 10\u201320%; NOT a verified COTA work rule). NTD cannot pin this down: annual\n  # scheduled hours come in 9.2% BELOW reported VRH while scheduled miles come\n  # in 13.7% ABOVE reported VRM, so the hours gap cannot be attributed to\n  # layover alone (the 2024 report year vs the May-2026 feed is the other\n  # candidate \u2014 COTA's VRH grew 13.3% from 2023 to 2024).\n  layover_ratio: 0.15\n  # Deadhead, operator availability: UNKNOWN \u2014 not modeled.\n  min_terminal_layover_min: 3\n  # NTD 2024 reported facts (agency 50016, motorbus, directly operated).\n  # Recorded for reporting and constraint sanity checks; not model inputs.\n  ntd_voms: 198                    # vehicles operated in maximum service\n  ntd_vams: 285                    # vehicles available for maximum service\n  ntd_spare_ratio_pct: 43.9        # was classified ESTIMABLE; now known\n  ntd_avg_fleet_age_years: 6.5\n  ntd_opex_per_revenue_hour: 209.68\n\ndemand_proxy:\n  # Stop catchment radius for allocating block-group jobs/residents to stops (m).\n  catchment_radius_m: 600\n  # Trip generation weights: how strongly residents vs jobs near a stop drive\n  # boardings. Proxy values; calibrate against APC when available.\n  resident_weight: 1.0\n  job_weight: 1.0\n  # ---------------------------------------------------------------------\n  # SCALE \u2014 now NTD-anchored, no longer a guess.\n  # The proxy's raw units are \"workers + jobs allocated to stops within the\n  # catchment\" (~940k for Central Ohio) \u2014 a relative measure, not trips.\n  # Unscaled it models every bus at ~400 passengers and lets the crowding term\n  # dominate the objective, so it is rescaled to a weekday linked-trip total.\n  # Derived from NTD 2024 (agency 50016): average weekday UPT 38,694 x bus\n  # share of annual UPT 95.98% = 37,139 weekday bus boardings; divided by\n  # (1 + transfer_rate 0.20) = 30,949 linked trips. Sensitivity is still swept.\n  assumed_weekday_linked_trips: 30949\n  # Temporal distribution of weekday transit demand by period (fractions sum to 1).\n  # Shaped from typical US bus demand profiles; NOT COTA-observed.\n  period_shares:\n    early: 0.05\n    am_peak: 0.22\n    midday: 0.33\n    pm_peak: 0.24\n    evening: 0.12\n    owl: 0.04\n\nwaiting:\n  # Expected wait as a function of headway h (minutes).\n  # If h <= random_arrival_threshold: E[wait] = h/2 (random arrivals).\n  # Else: E[wait] = threshold/2 + schedule_coefficient * (h - threshold)\n  # (passengers consult schedules on infrequent service).\n  random_arrival_threshold_min: 12\n  schedule_coefficient: 0.25\n  # Demand retention vs headway: fraction of proxy demand actually served falls\n  # linearly from 1.0 at headway<=retention_full_min to retention_floor at\n  # headway>=retention_zero_min. Beyond policy_max_headway all demand unserved.\n  retention_full_min: 15\n  retention_zero_min: 120\n  retention_floor: 0.25\n\npassenger:\n  # Mean share of a route's one-way runtime that an average passenger rides.\n  # DERIVED from NTD 2024: bus passenger-miles / unlinked trips = 4.601 mi per\n  # boarding; mean one-way route runtime 64.8 min at the NTD in-service speed of\n  # 12.20 mph = 13.18 mi end to end; 4.601 / 13.18 = 0.349. This independently\n  # confirms the 0.35 originally assumed, to within 0.2%.\n  avg_ride_fraction: 0.349\n  # Mean access walk time per trip (each end), minutes. Assumption.\n  access_walk_min: 5.0\n  # Share of passenger trips involving one transfer. COTA's observed rate is\n  # UNKNOWN (would come from APC/fare data); 0.20 is a typical mid-size bus value.\n  transfer_rate: 0.20\n\n# Path-based (RAPTOR) assignment. Used by Experiment 2.\npath_assignment:\n  walk_radius_m: 400          # stop-to-stop footpath radius for transfers\n  walk_speed_m_per_min: 80    # 4.8 km/h\n  access_radius_m: 600        # zone centroid to boarding stop\n  max_rounds: 3               # boardings, i.e. up to 2 transfers\n  max_paths_per_od: 4\n  n_random_scenarios: 3       # extra frequency draws used to widen the path set\n  od_top_k: 20000\n  # Trip retention as a function of the WHOLE journey's generalized cost, not\n  # just headway \u2014 this supersedes the headway-only retention curve used by the\n  # route-level experiment, because a path-based model knows the full journey.\n  # Linear from 1.0 at cost_retention_full to the floor at cost_retention_zero.\n  # A crude discouragement proxy, NOT a mode-choice model (see Step 11).\n  cost_retention_full_min: 60      # ~1 h perceived travel: nobody is put off\n  cost_retention_zero_min: 210\n  cost_retention_floor: 0.10\n\ncrowding:\n  bus_capacity: 60          # seated+standing planning capacity per 40-ft bus\n  # Crowding multiplier on in-vehicle time once load factor exceeds 1.0\n  crowding_penalty_per_excess_load: 1.0\n",
    "cost_weights.yaml": "# Generalized passenger cost weights, in equivalent in-vehicle minutes.\n# Values follow common transit planning practice (e.g., TCRP 165 ranges);\n# they are assumptions, not COTA-calibrated.\nweights:\n  walking: 2.0            # per walk minute\n  waiting: 2.0            # per expected wait minute\n  in_vehicle: 1.0         # per in-vehicle minute\n  transfer_wait: 2.0      # per transfer wait minute\n  transfer_penalty: 10.0  # fixed minutes-equivalent per transfer\n  crowding: 1.0           # extra multiplier applied via crowding model\n  reliability: 0.0        # placeholder until empirical RT data exists\n  unserved: 60.0          # minutes-equivalent penalty per unserved trip\n",
    "constraints.yaml": "# Service constraints for frequency optimization.\nresource:\n  # Budgets are set to \"baseline\" \u2014 computed from the current GTFS \u2014 unless\n  # overridden with explicit numbers here.\n  weekday_revenue_vehicle_hours: baseline\n  peak_fleet_by_period: baseline\n  # Solutions may not exceed the baseline envelope at all. Set to 0 so the claim\n  # \"inside COTA's current resource envelope\" needs no asterisk.\n  budget_tolerance: 0.0\n\nservice:\n  policy_max_headway_min: 60      # no route-period may exceed this if it had service\n  policy_min_headway_min: 5       # floor; below this bunching dominates\n  headway_ladder_min: [5, 6, 7.5, 10, 12, 15, 20, 24, 30, 40, 45, 60]\n  preserve_span: true             # a route-period with baseline service keeps service\n  allow_new_service_in_empty_periods: false\n",
    "sources.yaml": "# Authoritative data sources for the COTA transit optimization project.\n# status: AVAILABLE | BLOCKED_EGRESS (verified URL, sandbox cannot fetch; user-mediated\n#         retrieval) | UNKNOWN (not yet located) | NOT_RETRIEVED\nsources:\n  cota_gtfs_static:\n    name: COTA GTFS static feed\n    publisher: Central Ohio Transit Authority\n    url: https://www.cota.com/data/cota.gtfs.zip\n    retrieval_date: null  # set by registry at ingest\n    data_type: GTFS static (zip of CSV)\n    coverage: COTA fixed-route network, current signup\n    license: >-\n      COTA data terms (cota.com/data): non-exclusive, limited, revocable right to\n      use/reproduce/redistribute; as-is, no warranty; no COTA trademark use.\n    download_method: HTTP GET (user-mediated in this environment)\n    status: BLOCKED_EGRESS\n    notes: URL confirmed on cota.com/data 2026-08-25.\n  cota_gtfs_rt_alerts:\n    name: COTA GTFS-Realtime service alerts\n    publisher: COTA / Vontas\n    url: https://gtfs-rt.cota.vontascloud.com/TMGTFSRealTimeWebService/Alert/Alerts.pb\n    data_type: GTFS-RT protobuf\n    coverage: live alerts\n    license: same COTA data terms\n    download_method: HTTP GET\n    status: BLOCKED_EGRESS\n    notes: Confirmed on cota.com/data 2026-08-25.\n  cota_gtfs_rt_trip_updates:\n    name: COTA GTFS-Realtime trip updates\n    publisher: COTA via Swiftly\n    url: https://api.goswift.ly/real-time/cota/gtfs-rt-trip-updates\n    data_type: GTFS-RT protobuf\n    coverage: live trip updates\n    download_method: HTTP GET with public apiKey query param published on cota.com/data\n    status: BLOCKED_EGRESS\n    notes: Public key published by COTA on its data page; not stored here.\n  cota_gtfs_rt_vehicle_positions:\n    name: COTA GTFS-Realtime vehicle positions\n    publisher: COTA via Swiftly\n    url: https://api.goswift.ly/real-time/cota/gtfs-rt-vehicle-positions\n    data_type: GTFS-RT protobuf\n    coverage: live vehicle positions\n    download_method: HTTP GET with public apiKey query param published on cota.com/data\n    status: BLOCKED_EGRESS\n  cota_gis_open_data:\n    name: COTA open GIS data portal\n    publisher: COTA\n    url: http://cota1974.maps.arcgis.com/home/index.html\n    data_type: ArcGIS Online items (shapefile/GeoJSON services)\n    coverage: routes, stops, park & ride\n    status: BLOCKED_EGRESS\n    notes: Linked from cota.com/data.\n  ntd_cota:\n    name: National Transit Database 2024 Annual Agency Profile \u2014 COTA (NTD ID 50016)\n    publisher: Federal Transit Administration\n    url: https://www.transit.dot.gov/sites/fta.dot.gov/files/transit_agency_profile_doc/2024/50016.pdf\n    data_type: annual agency statistics (VRM, VRH, fleet, ridership, opex)\n    coverage: COTA, calendar year 2024\n    license: US federal government work, public domain\n    download_method: HTTP GET (user-mediated in this environment)\n    status: BLOCKED_EGRESS\n    notes: >-\n      COTA's NTD ID is 50016 (an earlier guess of 50066 was wrong). Parsed\n      deterministically by cota_opt.ntd, which rejects any parse that fails to\n      reproduce the profile's own 18 printed efficiency ratios. Supplies the\n      weekday-boardings anchor for the demand scale, the passenger trip length\n      that validates avg_ride_fraction, VOMS/VAMS/spare ratio, and operating\n      expense per revenue hour. Prior-year profiles use the same URL pattern.\n  lodes_od_oh:\n    name: LEHD LODES8 Ohio OD (JT00, main)\n    publisher: US Census Bureau LEHD\n    url: https://lehd.ces.census.gov/data/lodes/LODES8/oh/od/oh_od_main_JT00_2022.csv.gz\n    data_type: block-to-block home\u2192work job flows\n    coverage: Ohio, 2022\n    status: BLOCKED_EGRESS\n    notes: Large; WAC/RAC used first for stop-catchment weights.\n  lodes_wac_oh:\n    name: LEHD LODES8 Ohio WAC (S000 JT00 2022)\n    publisher: US Census Bureau LEHD\n    url: https://lehd.ces.census.gov/data/lodes/LODES8/oh/wac/oh_wac_S000_JT00_2022.csv.gz\n    data_type: jobs by workplace census block\n    coverage: Ohio, 2022\n    status: BLOCKED_EGRESS\n  lodes_rac_oh:\n    name: LEHD LODES8 Ohio RAC (S000 JT00 2022)\n    publisher: US Census Bureau LEHD\n    url: https://lehd.ces.census.gov/data/lodes/LODES8/oh/rac/oh_rac_S000_JT00_2022.csv.gz\n    data_type: workers by residence census block\n    coverage: Ohio, 2022\n    status: BLOCKED_EGRESS\n  cenpop_bg_oh:\n    name: 2020 Census block-group population centroids, Ohio\n    publisher: US Census Bureau\n    url: https://www2.census.gov/geo/docs/reference/cenpop2020/blkgrp/CenPop2020_Mean_BG39.txt\n    data_type: CSV (GEOID, population, mean center lat/lon)\n    coverage: Ohio block groups\n    status: BLOCKED_EGRESS\n  acs_5yr:\n    name: ACS 5-year estimates via Census API\n    publisher: US Census Bureau\n    url: https://api.census.gov/data/2023/acs/acs5\n    data_type: demographic/commuting tables\n    coverage: Franklin County + neighbors, tract/BG\n    status: BLOCKED_EGRESS\n    notes: >-\n      Relevant variables \u2014 B01003_001E population; B08301 means of transportation\n      to work (B08301_010E transit); B08201/B25044 vehicles available\n      (zero-car households); B19013_001E median household income; B23025 employment\n      status; S1810/B18101 disability. Recorded for future retrieval; no normative\n      demographic weights are embedded in optimization.\n  morpc_traffic_counts:\n    name: MORPC regional traffic count database\n    publisher: Mid-Ohio Regional Planning Commission\n    url: UNKNOWN\n    data_type: traffic counts\n    status: UNKNOWN\n    notes: Not yet located from within sandbox; MORPC hosts counts via its GIS portal.\n  odot_traffic:\n    name: ODOT Traffic Count/TDMS data\n    publisher: Ohio DOT\n    url: UNKNOWN\n    data_type: statewide traffic monitoring\n    status: UNKNOWN\n  cota_planning_docs:\n    name: COTA planning documents (LinkUS, System Redesign, APC/ridership reports)\n    publisher: COTA\n    url: UNKNOWN\n    data_type: PDF reports\n    status: UNKNOWN\n    notes: Stop-level APC data likely requires a public records request.\n"
  },
